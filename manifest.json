{
  "manifest_version": 3,
  "name": "X Emissary",
  "short_name": "X Emissary",
  "version": "1.0.0",
  "description": "Send any post on X to your Discord channels — text, images, video and optional translation — right from the share menu.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://api.fxtwitter.com/*",
    "https://*.twimg.com/*",
    "https://translate.googleapis.com/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "X Emissary — options",
    "default_popup": "options/options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
